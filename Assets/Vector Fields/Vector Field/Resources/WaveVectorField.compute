// Animates a source vector field by modulating its flow magnitude with a gust wave that travels along the flow in
// world space — the field-side equivalent of wind rippling across grass. Reads an already-encoded source field
// (rg = v*0.5+0.5), scales each vector by a travelling 0..1 gust, and writes the encoded result. Unit-magnitude out;
// the component's Render() applies its own magnitude/cookie afterwards.
#pragma kernel CSMain

#define THREADS_X 8
#define THREADS_Y 8

RWTexture2D<float4> Result;
Texture2D<float4> SourceTex;
SamplerState sampler_linear_clamp;   // Unity inline sampler: bilinear, clamped

int width;
int height;
float4x4 gridToWorldMatrix;          // grid cell -> world (this field's placement)
float waveScale;                     // gust wave spatial frequency (per world unit along the flow)
float waveSpeed;                     // gust travel speed along the flow
float waveAmount;                    // 0 = steady (pass-through), 1 = fully gusting
float time;                          // seconds; advances while animating

[numthreads(THREADS_X, THREADS_Y, 1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)width || id.y >= (uint)height) return;
    uint2 p = id.xy;

    // Sample the source field's full extent across this field's grid, decode to a raw flow vector.
    float2 uv = (float2(p.x, p.y) + 0.5) / float2(width, height);
    float2 v = (SourceTex.SampleLevel(sampler_linear_clamp, uv, 0).rg - 0.5) * 2.0;

    // Gust travels along the world-space flow direction, so bands sweep the way the field points.
    float3 worldPos = mul(gridToWorldMatrix, float4((float)p.x, (float)p.y, 0, 1)).xyz;
    float3 axisX = normalize(mul((float3x3)gridToWorldMatrix, float3(1, 0, 0)));
    float3 axisY = normalize(mul((float3x3)gridToWorldMatrix, float3(0, 1, 0)));
    float3 flowWorld = v.x * axisX + v.y * axisY;
    float3 dir = (length(flowWorld) > 1e-4) ? normalize(flowWorld) : axisY;

    float phase = dot(worldPos, dir) * waveScale - time * waveSpeed;
    float gust = lerp(1.0, 0.5 + 0.5 * sin(phase), saturate(waveAmount));
    v *= gust;

    Result[p] = float4(v.x * 0.5 + 0.5, v.y * 0.5 + 0.5, 0, 1);
}
