/* Shared design system for the Vector Field component inspectors. All colours reference Unity's built-in
   editor USS variables so light and dark themes both read correctly; the only fixed colour is the plugin
   accent, chosen to sit well on either theme. See VectorFieldInspectorUI.cs for the elements that use these. */

/* --- Section: a 1:1 replica of Unity's UITK header-foldout (com.unity.render-pipelines.core
   HeaderFoldout.uss + HeaderFoldoutDark.uss), the same element the Camera inspector uses. --------------- */
.vf-section {
    margin: 0;
}

/* The foldout element == Unity's ".header-foldout". Escape the InspectorElement's content padding so the
   header bar is truly full-width (Unity uses exactly margin 0 -6 0 -15), and draw the separator as a 1px
   bottom border. Covers both the wrapper sections (.vf-section > Foldout) and the Diagnostics foldout
   (which is itself .vf-section). Colour #1f1f1f is HeaderFoldoutDark's border colour. */
.vf-section > .unity-foldout,
.vf-section.unity-foldout {
    margin: 0 -6px 0 -15px;
    border-width: 0 0 1px 0;
    border-color: #1f1f1f;
}

/* Header row fill (#323232 = HeaderFoldoutDark's toggle background) + bold label. */
.vf-section > .unity-foldout > .unity-foldout__toggle,
.vf-section.unity-foldout > .unity-foldout__toggle {
    -unity-font-style: bold;
    background-color: #323232;
    margin: 0;
    padding-top: 3px;
    padding-bottom: 3px;
}

/* Content: bring it back in from the bled-out edge (+15 cancels the -15) to the normal field column, plus a
   small indent so fields sit under the header. */
.vf-section > .unity-foldout > .unity-foldout__content,
.vf-section.unity-foldout > .unity-foldout__content {
    margin-left: 15px;
    padding-top: 3px;
    padding-bottom: 4px;
    padding-left: 4px;
}

/* Nested sub-card (e.g. one blend layer inside the Group inspector). No foldout arrow here, so a light
   rounded panel is fine and helps nest each layer's fields within the flat Layers section. */
.vf-subsection {
    margin-top: 4px;
    padding: 3px 6px 5px 6px;
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
    border-radius: 4px;
}

.vf-subsection__title {
    -unity-font-style: bold;
    margin-bottom: 2px;
}

/* --- Inline help text (muted, wrapping) ------------------------------------------------------------------ */
.vf-help {
    white-space: normal;
    opacity: 0.7;
    font-size: 11px;
    margin: 2px 2px 4px 2px;
}

/* --- Footer: actions + diagnostics under the sections -------------------------------------------------- */
.vf-footer {
    margin-top: 8px;
}

.vf-footer Button {
    height: 22px;
}

/* --- Grid-size lock (chain-link) button, sits at the end of the Grid Size field's input row --------------- */
.vf-lock {
    width: 18px;
    height: 18px;
    margin: 1px 0 1px 3px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.vf-lock:hover {
    background-color: var(--unity-colors-button-background-hover);
}

/* --- Segmented enum control (side-by-side options, like a toggle button group) --------------------------- */
.vf-seg-group {
    flex-direction: row;
}

.vf-seg {
    flex-grow: 1;
    margin: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--unity-colors-button-border);
}

.vf-seg--first {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.vf-seg--last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* Collapse the seam between adjacent buttons. */
.vf-seg--mid,
.vf-seg--last {
    border-left-width: 0;
}

.vf-seg--active {
    background-color: #4a9db5;
    color: #ffffff;
    -unity-font-style: bold;
}

/* --- Diagnostics rows ------------------------------------------------------------------------------------ */
.vf-diag-row {
    flex-direction: row;
    margin-bottom: 1px;
}

.vf-diag-label {
    width: 78px;
    opacity: 0.7;
    font-size: 11px;
}

.vf-diag-value {
    flex-grow: 1;
    font-size: 11px;
}

.vf-diag-link {
    font-size: 11px;
}
