/* Shared design system for the Vector Field component inspectors. Colours reference Unity's built-in editor
   USS variables where one exists; the exceptions are the plugin accent and the section-header palette, which
   is lifted verbatim from RP-core's HeaderFoldoutDark/Light sheets and scoped by the vf-theme-* class that
   ApplyStyle puts on the editor root (USS itself has no theme awareness). See VectorFieldInspectorUI.cs. */

/* --- Section: the Camera-inspector section look — a full-width header bar with the arrow/title at the content
   column, and fields one indent level deeper. Built as a plain Foldout tagged .vf-section (MakeSection and the
   Diagnostics foldout); colours match RP-core's HeaderFoldout, geometry matches the Camera inspector. */

/* Escape the InspectorElement's content padding (15 left / 6 right) so the header bar is truly full-width,
   and draw the separator as a 1px bottom border. */
.vf-section {
    margin: 0 -6px 0 -15px;
    border-width: 0 0 1px 0;
}

.vf-theme-dark .vf-section { border-color: #1f1f1f; }   /* HeaderFoldoutDark */
.vf-theme-light .vf-section { border-color: #999999; }  /* HeaderFoldoutLight */

/* Header row: bold title; arrow + title inset one indent level so they sit at the inspector's content column,
   where the Camera inspector's section headers put theirs. */
.vf-section > .unity-foldout__toggle {
    -unity-font-style: bold;
    margin: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 15px;
}

.vf-theme-dark .vf-section > .unity-foldout__toggle { background-color: #323232; }
.vf-theme-light .vf-section > .unity-foldout__toggle { background-color: #d3d3d3; }

/* Content: cancel the -15 left bleed AND go one indent level deeper — the Camera inspector's sections indent
   their fields 15px past the top-level label column, so ours do too (30 = 15 bleed cancel + 15 indent).
   margin-right 6 cancels the -6 right bleed — without it the content column ends 6px past every other field
   and the inner fields overhang the scroll viewport by 2px, summoning a horizontal scrollbar. */
.vf-section > .unity-foldout__content {
    margin-left: 30px;
    margin-right: 6px;
    padding-top: 5px;
    padding-bottom: 4px;
}

/* Nested sub-card (e.g. one blend layer inside the Group inspector). No foldout arrow here, so a light
   rounded panel is fine and helps nest each layer's fields within the flat Layers section. */
.vf-subsection {
    margin-top: 4px;
    padding: 3px 6px 5px 6px;
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
    border-radius: 4px;
}

.vf-subsection__title {
    -unity-font-style: bold;
    margin-bottom: 2px;
}

/* --- Inline help text (muted, wrapping) ------------------------------------------------------------------ */
.vf-help {
    white-space: normal;
    opacity: 0.7;
    font-size: 11px;
    margin: 2px 2px 4px 2px;
}

/* --- Footer: actions + diagnostics under the sections -------------------------------------------------- */
.vf-footer {
    margin-top: 8px;
}

.vf-footer Button {
    height: 22px;
}

/* --- Grid-size lock (chain-link) button. In-flow as the first child of the field's input row, just left of X
   (like the Transform scale lock). NOT absolutely positioned: an absolute -20px offset lands outside the input
   row's box and gets clipped by its overflow (invisible lock), so it sits in-flow and shifts X/Y right ~20px. --- */
.vf-lock {
    width: 18px;
    height: 18px;
    margin-right: 2px;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.vf-lock:hover {
    background-color: var(--unity-colors-button-background-hover);
    border-radius: 2px;
}

.vf-lock__icon {
    width: 16px;
    height: 16px;
}

/* --- Segmented enum control (side-by-side options, like a toggle button group) --------------------------- */
.vf-seg-group {
    flex-direction: row;
}

.vf-seg {
    flex-grow: 1;
    margin: 0;
    border-radius: 0;
    border-width: 1px;
    border-color: var(--unity-colors-button-border);
}

.vf-seg--first {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
}

.vf-seg--last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
}

/* Collapse the seam between adjacent buttons. */
.vf-seg--mid,
.vf-seg--last {
    border-left-width: 0;
}

.vf-seg--active {
    background-color: #4a9db5;
    color: #ffffff;
    -unity-font-style: bold;
}

/* Icon + label laid out together, centred within the segmented button. */
.vf-seg__content {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.vf-seg__icon {
    width: 14px;
    height: 14px;
    margin-right: 5px;
    flex-shrink: 0;
}

/* --- Diagnostics rows ------------------------------------------------------------------------------------ */
.vf-diag-row {
    flex-direction: row;
    margin-bottom: 1px;
}

.vf-diag-label {
    width: 78px;
    opacity: 0.7;
    font-size: 11px;
}

.vf-diag-value {
    flex-grow: 1;
    font-size: 11px;
}

.vf-diag-link {
    font-size: 11px;
}
